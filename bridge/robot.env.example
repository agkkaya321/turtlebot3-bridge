# Copier vers robot.env et adapter aux valeurs réelles du cours.
# Le bridge ET le bringup hériteront du même environnement.
# Les variables exportées dans ~/.bashrc (LDS_MODEL…) sont reprises avant ce fichier.
export ROS_DOMAIN_ID=109
export TURTLEBOT3_MODEL=burger
# Décommenter et adapter uniquement si LDS_MODEL n'est ni ici ni dans ~/.bashrc :
# export LDS_MODEL=LDS-02
export ROS_AUTOSTART=true
export ROBOT_NAMESPACE=""
export CMD_VEL_TYPE=stamped
export BRIDGE_BIND=127.0.0.1:8000
# Vitesse maximale de chaque roue en m/s (0.10 par défaut, 0.22 au plus pour le Burger).
# export MAX_SPEED_MPS=0.10

# Caméra USB (usb_cam). Tout est facultatif : les valeurs ci-dessous sont les défauts.
# Le bridge lance usb_cam si aucun nœud ne publie déjà l'image.
# export CAMERA_AUTOSTART=true
# export CAMERA_DEVICE=/dev/video0
# export CAMERA_PIXEL_FORMAT=mjpeg2rgb      # évite l'image teintée de vert (guide du cours)
# export CAMERA_SOURCE_SIZE=1280x720      # 16:9 = toute la largeur du capteur ; 640x480 recadre souvent
# export CAMERA_SOURCE_FPS=15
# export CAMERA_TOPIC=/image_raw
# Flux envoyé à l'interface (aussi réglable depuis l'interface) :
# export CAMERA_WIDTH=480                   # largeur max, 80 à 1920 px
# export CAMERA_QUALITY=60                  # qualité JPEG, 10 à 95
# export CAMERA_FPS=15                      # images par seconde max, 1 à 30
# export CAMERA_ROTATE=0                    # 90 / 270 : webcam montée en portrait (corps entier)
