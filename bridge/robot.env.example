# Copy to robot.env and adjust to the actual course setup.
# The bridge AND bringup inherit the same environment.
# Variables exported in ~/.bashrc (LDS_MODEL, etc.) are imported before this file.
export ROS_DOMAIN_ID=109
export TURTLEBOT3_MODEL=burger
# Uncomment and adjust only if LDS_MODEL is set neither here nor in ~/.bashrc:
# export LDS_MODEL=LDS-02
export ROS_AUTOSTART=true
export ROBOT_NAMESPACE=""
export CMD_VEL_TYPE=stamped
export BRIDGE_BIND=127.0.0.1:8000
# Maximum speed per wheel in m/s (default 0.10, at most 0.22 for the Burger).
# export MAX_SPEED_MPS=0.10

# Optional Logitech Brio 105 (USB). Enable after installing usb_cam and
# image_transport_plugins on the robot. Uses the same HTTP port / SSH tunnel.
export CAMERA_ENABLED=false
export CAMERA_AUTOSTART=false
export CAMERA_DEVICE=/dev/video0
export CAMERA_WIDTH=640
export CAMERA_HEIGHT=480
export CAMERA_FPS=15
# Default: /image_raw, prefixed with ROBOT_NAMESPACE when set.
# The bridge subscribes to CAMERA_RAW_TOPIC + /compressed (JPEG).
# export CAMERA_RAW_TOPIC=/image_raw
